// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url moved to prisma.config.ts for Prisma 7
}

////////////////////////////////////////////////////
// ENUMS
////////////////////////////////////////////////////

enum UserRole {
  patient
  admin
  hospital_staff
}

enum HospitalRole {
  doctor
  nurse
  receptionist
  staff
  admin
}

enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

enum VisitType {
  scheduled
  walk_in
  follow_up
  emergency
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum BillSectionType {
  consultation
  pharmacy
  lab_test
  imaging
  other
}

////////////////////////////////////////////////////
// USERS & HOSPITALS
////////////////////////////////////////////////////

model User {
  user_id       String   @id @default(uuid()) @db.Uuid
  full_name     String   @db.VarChar(150)
  email         String   @unique @db.VarChar(150)
  phone         String?  @db.VarChar(20)
  password_hash String   @db.Text
  role          UserRole
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  // Relations
  refreshTokens         RefreshToken[]
  accessLogs            AccessLog[]
  patient               Patient?
  hospitalUsers         HospitalUser[]
  appointmentsAsDoctor  Appointment[]  @relation("DoctorAppointments")
  appointmentsAsCreator Appointment[]  @relation("AppointmentCreator")
  visitsAsDoctor        Visit[]
  prescriptions         Prescription[] @relation("PrescriptionPrescriber")

  @@index([email])
  @@map("users")
}

model Hospital {
  hospital_id    String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(200)
  address        String?  @db.Text
  contact_number String?  @db.VarChar(20)
  created_at     DateTime @default(now())

  // Relations
  hospitalUsers HospitalUser[] @relation("HospitalUsers")
  appointments  Appointment[]
  visits        Visit[]

  @@map("hospitals")
}

model HospitalUser {
  hospital_user_id String       @id @default(uuid()) @db.Uuid
  hospital_id      String       @db.Uuid
  user_id          String       @db.Uuid
  role_in_hospital HospitalRole
  created_at       DateTime     @default(now())

  // Relations
  hospital Hospital @relation("HospitalUsers", fields: [hospital_id], references: [hospital_id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([hospital_id])
  @@index([user_id])
  @@map("hospital_users")
}

////////////////////////////////////////////////////
// PATIENTS
////////////////////////////////////////////////////

model Patient {
  patient_id String @id @default(uuid()) @db.Uuid
  user_id    String @unique @db.Uuid

  // Patient Identification
  patient_number String @unique @db.VarChar(10) // 10-digit unique patient ID

  // Basic Information
  name        String    @db.VarChar(200)
  dob         DateTime? @db.Date
  gender      String?   @db.VarChar(10)
  blood_group String?   @db.VarChar(5)

  // Contact Information
  phone_number             String? @db.VarChar(20)
  guardian_phone           String? @db.VarChar(20)
  address                  String? @db.Text
  emergency_contact_name   String? @db.VarChar(200)
  emergency_contact_number String? @db.VarChar(20)

  // Personal Details
  marital_status String? @db.VarChar(20)
  spouse_name    String? @db.VarChar(200)
  caste          String? @db.VarChar(100)
  religion       String? @db.VarChar(100)
  nationality    String? @db.VarChar(100)

  // Medical Information
  photo_url String? @db.Text

  // NFC Card
  nfc_card_uid String? @unique @db.VarChar(100)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  // Relations
  user              User                      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  allergies         PatientAllergy[]
  chronicConditions PatientChronicCondition[]
  appointments      Appointment[]
  visits            Visit[]
  notifications     Notification[]
  deviceTokens      DeviceToken[]

  @@index([user_id])
  @@index([patient_number])
  @@index([name])
  @@index([phone_number])
  @@index([nfc_card_uid])
  @@map("patients")
}

model PatientAllergy {
  allergy_id   String   @id @default(uuid()) @db.Uuid
  patient_id   String   @db.Uuid
  allergy_name String   @db.VarChar(200)
  severity     String?  @db.VarChar(50)
  notes        String?  @db.Text
  created_at   DateTime @default(now())

  // Relations
  patient Patient @relation(fields: [patient_id], references: [patient_id], onDelete: Cascade)

  @@index([patient_id])
  @@map("patient_allergies")
}

model PatientChronicCondition {
  condition_id   String    @id @default(uuid()) @db.Uuid
  patient_id     String    @db.Uuid
  condition_name String    @db.VarChar(200)
  diagnosed_date DateTime? @db.Date
  notes          String?   @db.Text
  created_at     DateTime  @default(now())

  // Relations
  patient Patient @relation(fields: [patient_id], references: [patient_id], onDelete: Cascade)

  @@index([patient_id])
  @@map("patient_chronic_conditions")
}

////////////////////////////////////////////////////
// APPOINTMENTS (Scheduling)
////////////////////////////////////////////////////

model Appointment {
  appointment_id      String            @id @default(uuid()) @db.Uuid
  patient_id          String            @db.Uuid
  doctor_id           String            @db.Uuid
  hospital_id         String            @db.Uuid
  department          String            @db.VarChar(100)
  reason              String?           @db.Text
  scheduled_date_time DateTime
  status              AppointmentStatus
  visit_id            String?           @unique @db.Uuid

  // Metadata
  created_by       String    @db.Uuid
  notes            String?   @db.Text
  cancelled_at     DateTime? @db.Timestamp
  cancelled_reason String?   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  // Relations
  patient  Patient  @relation(fields: [patient_id], references: [patient_id], onDelete: Cascade)
  doctor   User     @relation("DoctorAppointments", fields: [doctor_id], references: [user_id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospital_id], references: [hospital_id], onDelete: Cascade)
  creator  User     @relation("AppointmentCreator", fields: [created_by], references: [user_id], onDelete: Cascade)
  visit    Visit?   @relation("AppointmentVisit", fields: [visit_id], references: [visit_id], onDelete: SetNull)

  @@index([patient_id])
  @@index([doctor_id])
  @@index([scheduled_date_time])
  @@index([status])
  @@index([hospital_id])
  @@index([visit_id])
  @@map("appointments")
}

////////////////////////////////////////////////////
// VISITS (Medical Encounters)
////////////////////////////////////////////////////

model Visit {
  visit_id String @id @default(uuid()) @db.Uuid

  // Patient & Doctor Info
  patient_id  String @db.Uuid
  hospital_id String @db.Uuid
  doctor_id   String @db.Uuid

  // Visit Details
  visit_date DateTime
  visit_type VisitType

  // Medical Record Fields
  diagnosis       String?   @db.Text
  notes           String?   @db.Text
  advice          String?   @db.Text
  next_visit_date DateTime? @db.Date

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  // Relations
  appointment   Appointment?   @relation("AppointmentVisit")
  patient       Patient        @relation(fields: [patient_id], references: [patient_id], onDelete: Cascade)
  hospital      Hospital       @relation(fields: [hospital_id], references: [hospital_id], onDelete: Cascade)
  doctor        User           @relation(fields: [doctor_id], references: [user_id], onDelete: Cascade)
  prescriptions Prescription[]
  reports       Report[]
  bill          Bill?

  @@index([patient_id])
  @@index([doctor_id])
  @@index([visit_date])
  @@index([hospital_id])
  @@map("visits")
}

////////////////////////////////////////////////////
// PRESCRIPTIONS & MEDICATIONS
////////////////////////////////////////////////////

model Prescription {
  prescription_id   String   @id @default(uuid()) @db.Uuid
  visit_id          String   @db.Uuid
  prescribed_by     String   @db.Uuid
  prescription_text String?  @db.Text
  created_at        DateTime @default(now())

  // Relations
  visit       Visit        @relation(fields: [visit_id], references: [visit_id], onDelete: Cascade)
  prescriber  User         @relation("PrescriptionPrescriber", fields: [prescribed_by], references: [user_id], onDelete: Cascade)
  medications Medication[]

  @@index([visit_id])
  @@index([prescribed_by])
  @@map("prescriptions")
}

model Medication {
  medication_id   String  @id @default(uuid()) @db.Uuid
  prescription_id String  @db.Uuid
  drug_name       String  @db.VarChar(200)
  dosage          String? @db.VarChar(100)
  frequency       String? @db.VarChar(100)
  duration        String? @db.VarChar(100)
  instructions    String? @db.Text

  // Relations
  prescription Prescription @relation(fields: [prescription_id], references: [prescription_id], onDelete: Cascade)

  @@index([prescription_id])
  @@map("medications")
}

////////////////////////////////////////////////////
// REPORTS & FILES
////////////////////////////////////////////////////

model Report {
  report_id   String   @id @default(uuid()) @db.Uuid
  visit_id    String   @db.Uuid
  report_type String   @db.VarChar(100)
  file_url    String   @db.Text
  file_type   String?  @db.VarChar(20)
  uploaded_at DateTime @default(now())

  // Relations
  visit Visit @relation(fields: [visit_id], references: [visit_id], onDelete: Cascade)

  @@index([visit_id])
  @@index([report_type])
  @@map("reports")
}

////////////////////////////////////////////////////
// BILLING
////////////////////////////////////////////////////

model Bill {
  bill_id        String        @id @default(uuid()) @db.Uuid
  visit_id       String        @unique @db.Uuid
  total_amount   Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD") @db.VarChar(10)
  payment_status PaymentStatus
  payment_date   DateTime?     @db.Timestamp
  created_at     DateTime      @default(now())

  // Relations
  visit        Visit         @relation(fields: [visit_id], references: [visit_id], onDelete: Cascade)
  billSections BillSection[]

  @@index([visit_id])
  @@index([payment_status])
  @@map("bills")
}

model BillSection {
  section_id    String          @id @default(uuid()) @db.Uuid
  bill_id       String          @db.Uuid
  section_type  BillSectionType
  section_total Decimal         @db.Decimal(10, 2)
  created_at    DateTime        @default(now())

  // Relations
  bill      Bill       @relation(fields: [bill_id], references: [bill_id], onDelete: Cascade)
  billItems BillItem[]

  @@index([bill_id])
  @@map("bill_sections")
}

model BillItem {
  item_id     String  @id @default(uuid()) @db.Uuid
  section_id  String  @db.Uuid
  description String  @db.VarChar(255)
  quantity    Int     @default(1)
  unit_price  Decimal @db.Decimal(10, 2)
  total_price Decimal @db.Decimal(10, 2)

  // Relations
  section BillSection @relation(fields: [section_id], references: [section_id], onDelete: Cascade)

  @@index([section_id])
  @@map("bill_items")
}

////////////////////////////////////////////////////
// NOTIFICATIONS
////////////////////////////////////////////////////

enum NotificationType {
  appointment_scheduled
  appointment_confirmed
  appointment_cancelled
  appointment_reminder
  appointment_completed
  visit_recorded
  prescription_ready
  bill_generated
  bill_paid
  report_uploaded
  general
}

model Notification {
  notification_id String           @id @default(uuid()) @db.Uuid
  patient_id      String           @db.Uuid
  type            NotificationType
  title           String           @db.VarChar(255)
  body            String           @db.Text
  data            Json? // extra payload (appointment_id, etc.)
  is_read         Boolean          @default(false)
  created_at      DateTime         @default(now())

  // Relations
  patient Patient @relation(fields: [patient_id], references: [patient_id], onDelete: Cascade)

  @@index([patient_id])
  @@index([is_read])
  @@index([created_at])
  @@map("notifications")
}

model DeviceToken {
  token_id   String   @id @default(uuid()) @db.Uuid
  patient_id String   @db.Uuid
  fcm_token  String   @db.Text
  platform   String   @db.VarChar(20) // android | ios
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  // Relations
  patient Patient @relation(fields: [patient_id], references: [patient_id], onDelete: Cascade)

  @@unique([patient_id, fcm_token])
  @@index([patient_id])
  @@map("device_tokens")
}

model AccessLog {
  log_id     BigInt   @id @default(autoincrement())
  user_id    String?  @db.Uuid
  action     String   @db.VarChar(200)
  timestamp  DateTime @default(now())
  ip_address String?  @db.VarChar(50)
  user_agent String?  @db.Text
  success    Boolean

  // Relations
  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id])
  @@index([timestamp])
  @@index([action])
  @@map("access_logs")
}

model RefreshToken {
  token_id      String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  refresh_token String   @unique @db.Text
  expires_at    DateTime
  created_at    DateTime @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([refresh_token])
  @@map("refresh_tokens")
}
